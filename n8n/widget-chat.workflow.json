        "jsCode": "const SITES = {\n  \"mysa-lifestyle.myshopify.com\": {\n    brand: \"dearist\",\n    backend: \"https://datastraw-support-agent-production-54f5.up.railway.app/api/widget/chat\",\n    origins: [\n      \"https://mysa-lifestyle.myshopify.com\",\n      \"http://127.0.0.1:8080\",\n    ],\n  },\n};\nconst body = $json.body || {};\nconst origin = $json.headers?.origin || \"\";\nconst site = SITES[body.site_id];\nconst ok = !!site\n  && site.origins.includes(origin)\n  && typeof body.message === \"string\" && body.message.length > 0 && body.message.length <= 1000\n  && typeof body.session_id === \"string\" && body.session_id.length <= 100;\nreturn { json: { ok, backend: site?.backend, payload: ok ? {\n  message: body.message, session_id: body.session_id,\n  platform: body.platform || \"web\", page_url: body.page_url || null } : null } };"
