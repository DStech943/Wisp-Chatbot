{
  "rewrites": [
    {
      "source": "/",
      "destination": "/docs-site/index.html"
    },
    {
      "source": "/install-shopify",
      "destination": "/docs-site/install-shopify.html"
    },
    {
      "source": "/install-website",
      "destination": "/docs-site/install-website.html"
    },
    {
      "source": "/dashboard",
      "destination": "/docs-site/dashboard.html"
    },
    {
      "source": "/:path*",
      "destination": "/docs-site/:path*"
    }
  ]
}
